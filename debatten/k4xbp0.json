[{"id":4623,"stance":"pro","typology":"economic","quote_text":"Waarom zouden we niet kijken wat er mogelijk is, zodat het niet alleen gaat om humanitaire redenen maar ook om hun bijdrage aan de Nederlandse samenleving, het economische belang en een sociaal perspectief? Valt er niet wat uit te werken? Daar moeten we serieus mee aan de slag gaan.","quote_context":"De spreker pleit voor een oplossing voor de groep mensen in de asielketenprocedure die niet weggaan, door hun bijdrage aan de samenleving en economie te benutten.","prompt_version":"0b12780c7cac","start_seconds":425.5600000000013,"end_seconds":441.380000000001,"actor":{"name":"Don Ceder","party":"ChristenUnie","role_title":null},"document":{"id":12324,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/503385e4-089a-4efe-a21e-7f3b293f5bc2/resource","video_url":"https://debatdirect.tweedekamer.nl/2025-10-02/migratie-en-integratie/plenaire-zaal/tweeminutendebat-kinderen-in-asielopvang-cd-23-9-14-30/video","published_at":"2025-10-02T14:11:22","speaker_video_url":"https://debatdirect.tweedekamer.nl/2025-10-02/migratie-en-integratie/plenaire-zaal/tweeminutendebat-kinderen-in-asielopvang-cd-23-9-14-30?event=speaker2025-10-02T14%3A11%3A22%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2025A06430","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2025-10-02/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2025-10-02T14%3A04%3A57%2B0200&end=2025-10-02T14%3A38%3A08%2B0200"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Schoof"},"claims":[],"tags":[],"oppositions":[]}]