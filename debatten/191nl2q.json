[{"id":9159,"stance":"pro","typology":"factual","quote_text":"De file op het stroomnet is een nationale crisis. Het ontzegt mensen een woning, dwarsboomt de groei van ondernemers en maakt ons afhankelijk. Dit is niet het moment om nog eens een studie aan te vragen, dit is het moment om door roeien en ruiten te gaan. Meer ruimte op het net betekent meer schone energie van Nederlandse bodem, een betaalbare energierekening en meer ruimte om op te staan in de wereld voor onze waarden. Ik hoor vaak: het kan niet, het is ingewikkeld en het duurt lang. Maar laten we vandaag juist zeggen: het kan wél en het kan snel. Nederland is groot geworden door creativiteit, daadkracht en samenwerking. Met de Crisiswet netcongestie kunnen we bouwen aan het energienet van de toekomst.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":684.6790000000001,"end_seconds":721.7790000000005,"actor":{"name":"Felix Klos","party":"D66","role_title":null},"document":{"id":31954,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/ee9b959d-d734-4ada-b457-7a8763886277/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-05-27/economie/plenaire-zaal/tweeminutendebat-netcongestie-en-elektriciteitsnet-cd-22-4-10-15/video","published_at":"2026-05-27T10:56:39","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-05-27/economie/plenaire-zaal/tweeminutendebat-netcongestie-en-elektriciteitsnet-cd-22-4-10-15?event=speaker2026-05-27T10%3A56%3A39%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A03081","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-05-27/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-05-27T10%3A45%3A16%2B0200&end=2026-05-27T11%3A24%3A02%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[],"oppositions":[]},{"id":9160,"stance":"contra","typology":"f