[{"id":18982,"key":"913277e650bf","stance":"pro","typology":"factual","quote_text":"Al in 2019 heeft Nederland vastgesteld dat er in 2030 nagenoeg nul emissie moet zijn naar het milieu. We zijn al tien jaar verder en we zijn er nog lang niet. Er is nog steeds veel te veel landbouwgif in ons water en in onze natuur en het is inmiddels ook een van de grootste bronnen van pfas in Nederland geworden.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":5562.061,"end_seconds":5577.540000000001,"actor":{"name":"Ines Kostić","party":"PvdD","role_title":null},"document":{"id":1370924,"external_id":"d8ae58c7-774b-48c2-9af5-5e1c0efc9e68","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/59b989af-1a6c-427c-b373-3401c47a7905/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-10-08/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/gewasbeschermingsmiddelen-10-00/video","published_at":"2026-10-08T11:34:39","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-10-08/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/gewasbeschermingsmiddelen-10-00?event=speaker2026-10-08T11%3A34%3A39%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-10-08/groenvanprinstererzaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-10-08T10%3A02%3A00%2B0200&end=2026-10-08T14%3A59%3A16%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"Nederland heeft in 2019 vastgesteld dat er in 2030 nagenoeg nul emissie moet zijn naar het milieu","attributed_source_text":null},{"claim_text":"Er is nog steeds veel te veel landbouwgif in ons water en in onze natuur","attributed_source_text":null},{"claim_text":"Landbouwgif is inmiddels ook een van de grootste bronnen van pfas in Nederland geworden","attributed_source_text":null}],"tags":[]},{"id":18983,"key":"614e0c269353","stance":"pro","typology":"factual","quote_text":"Het RIVM concl