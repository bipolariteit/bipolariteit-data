[{"id":17858,"key":"cd4ecf2d9fef","stance":"contra","typology":"economic","quote_text":"U hebt het over bullshitdekkingen, maar wij gooien zo veel geld naar Oekraïne. Wij zijn koploper als het gaat om donaties aan Oekraïne. Wij zijn ook begaan met Oekraïne, maar wij zeggen: laat Spanje en Italië eens een keer wat doen. Zij doen helemaal niks en wij gooien ons hele hebben en houden ... De teller staat nu al op 25 miljard en er staat nog eens 20 miljard op de rol. We geven 45 miljard aan Oekraïne.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":1127.42,"end_seconds":1153.9599999999991,"actor":{"name":"Tony van Dijck","party":"PVV","role_title":null},"document":{"id":56722,"external_id":"25f8a050-b00c-4b2e-b447-40f936eeaa88","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T11:31:01","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=interrupter2026-04-23T11%3A31%3A01%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"De teller staat nu al op 25 miljard en er staat nog eens 20 miljard op de rol","attributed_source_text":null},{"claim_text":"We geven 45 miljard aan Oekraïne","attributed_source_text":null}],"tags":[]},{"id":17859,"key":"0353bebe1107","stance":"pro","typology":"factual","quote_text":"De Partij voor de Dieren is het helemaal eens met D66 dat we nu de transitie echt moeten versnellen, want het is een groot gevaar voor onze nationale veiligheid als we afhankelijk blijven van fossiele brandstoffen.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":3020,"end_seconds":3031.138999999999,"actor":{"name":"Christine Teunissen","party":"PvdD","role_title":null},"document":{"id":56796,"external_id":"46de8b8c-9fa4-4c63-b87e-cce881d905c6","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T12:03:07","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=interrupter2026-04-23T12%3A03%3A07%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":17860,"key":"df128997d738","stance":"pro","typology":"economic","quote_text":"We zien nu dat Europese landen tot nu toe 24 miljard extra kwijt zijn doordat we afhankelijk zijn van olie en gas.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":3037.6190000000006,"end_seconds":3045.1990000000005,"actor":{"name":"Christine Teunissen","party":"PvdD","role_title":null},"document":{"id":56796,"external_id":"46de8b8c-9fa4-4c63-b87e-cce881d905c6","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T12:03:07","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=interrupter2026-04-23T12%3A03%3A07%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"Europese landen tot nu toe 24 miljard extra kwijt zijn doordat we afhankelijk zijn van olie en gas","attributed_source_text":null}],"tags":[]},{"id":17861,"key":"3fbc7d4c0640","stance":"contra","typology":"factual","quote_text":"Ik zie ook dat het kabinet 13,4 miljard investeert in kernenergie. Dat ligt nu gewoon op de plank.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":3045.9400000000005,"end_seconds":3053.0589999999993,"actor":{"name":"Christine Teunissen","party":"PvdD","role_title":null},"document":{"id":56796,"external_id":"46de8b8c-9fa4-4c63-b87e-cce881d905c6","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T12:03:07","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=interrupter2026-04-23T12%3A03%3A07%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"het kabinet 13,4 miljard investeert in kernenergie","attributed_source_text":null}],"tags":[]},{"id":17856,"key":"d38b4e2e7e87","stance":"contra","typology":"economic","quote_text":"Ik ben het helemaal eens met mevrouw Teunissen. Zij stipt terecht aan dat het best wel dom en vervelend is om heel veel geld naar het buitenland te blijven brengen om olie en gas hiernaartoe te halen. Daar hebben we het ook veel te weinig over met elkaar.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":3067,"end_seconds":3081.379999999999,"actor":{"name":"Henk-Jan Oosterhuis","party":"D66","role_title":null},"document":{"id":56799,"external_id":"1879a2fc-0d0a-4b4f-bc10-8260f45ccbf7","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T12:03:54","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=speaker2026-04-23T12%3A03%3A54%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":17857,"key":"2271f169fb13","stance":"contra","typology":"factual","quote_text":"Tegelijkertijd vind ik het juist ook voor het draagvlak voor de transitie erg belangrijk dat we een combinatie van bronnen kiezen, dus kernenergie, windenergie en zonne-energie. Daarom wil ik ook dat we doorgaan met kernenergie.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":3090.34,"end_seconds":3105.5199999999986,"actor":{"name":"Henk-Jan Oosterhuis","party":"D66","role_title":null},"document":{"id":56799,"external_id":"1879a2fc-0d0a-4b4f-bc10-8260f45ccbf7","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T12:03:54","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=speaker2026-04-23T12%3A03%3A54%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":17849,"key":"d8b08f0084d5","stance":"pro","typology":"economic","quote_text":"Als je kijkt naar wat kernenergie doet, zie je dat we daar de komende tien jaar, waarschijnlijk de komende twintig jaar, nog helemaal niks aan hebben. We kunnen over tien jaar namelijk pas beginnen met bouwen. De vraag is dus: waarom zetten we die 14,3 miljard niet in voor de transitie die nú nodig is?","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":3120.0589999999993,"end_seconds":3139.5,"actor":{"name":"Christine Teunissen","party":"PvdD","role_title":null},"document":{"id":56800,"external_id":"8033601f-a18d-43b9-845d-df94651fa7f8","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T12:04:38","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=interrupter2026-04-23T12%3A04%3A38%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"We kunnen over tien jaar namelijk pas beginnen met bouwen","attributed_source_text":null},{"claim_text":"14,3 miljard","attributed_source_text":null}],"tags":[]},{"id":17845,"key":"55ceb2a3948c","stance":"pro","typology":"factual","quote_text":"Dat doen we dus juist niet door die miljarden voor kernenergie op de plank te laten liggen. Ik hoop dat D66 nu toch kijkt naar de mogelijkheden die we hebben om fors energie te besparen en de inzet op zon, wind, opslag en groene waterstof te gaan versnellen.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":3165,"end_seconds":3179.459999999999,"actor":{"name":"Christine Teunissen","party":"PvdD","role_title":null},"document":{"id":56803,"external_id":"90e372e7-a942-4e73-b463-1eff2c0b61f7","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T12:05:32","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=interrupter2026-04-23T12%3A05%3A32%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":17844,"key":"4e700b0b5416","stance":"contra","typology":"factual","quote_text":"Realiseert de heer Oosterhuis zich dat het uiteindelijk aankomt op praktisch kijken wat nodig is en dat je vanaf de Haagse tekentafel niet de oplossingen voor Nederland bereikt?","quote_context":"Reactie op de vraag over offshore windenergie (factor tien op de Noordzee) en de vermelding van natuurgebieden.","prompt_version":"0b12780c7cac","start_seconds":4501.058999999999,"end_seconds":4513.058999999999,"actor":{"name":"Mona Keijzer","party":"Lid Keijzer","role_title":null},"document":{"id":56861,"external_id":"4b0d780b-1825-4bc8-b302-6f9046db30ac","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T12:27:24","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=interrupter2026-04-23T12%3A27%3A24%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":17846,"key":"f527569f4f12","stance":"contra","typology":"economic","quote_text":"Wat we nu nodig hebben, is betaalbare brandstof, goedkopere boodschappen en een behapbare energierekening. Maar nee, we krijgen een lening om te verduurzamen en €0,02 extra kilometervergoeding, die de werkgever mag betalen. Dat is een klap in het gezicht van elke Nederlander, een belediging.","quote_context":"Kritiek op het crisispakket van het kabinet","prompt_version":"0b12780c7cac","start_seconds":5020.361000000001,"end_seconds":5038.120000000001,"actor":{"name":"Tony van Dijck","party":"PVV","role_title":null},"document":{"id":56885,"external_id":"2b5349f4-5156-4d9c-a8bd-7e7fe020ebc9","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T12:35:28","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=speaker2026-04-23T12%3A35%3A28%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"Het kabinet biedt een lening om te verduurzamen en €0,02 extra kilometervergoeding","attributed_source_text":null}],"tags":[]},{"id":17847,"key":"80a535810c9e","stance":"contra","typology":"economic","quote_text":"Er gaat dit jaar 6,5 miljard naar Oekraïne, 6,5 miljard naar Afrika, 14 miljard naar Brussel, 6 miljard naar asielopvang en 8 miljard naar windmolens op zee. Opgeteld gaat er alleen dit jaar al 40 miljard belastinggeld door het putje. En dat elk jaar weer. Dat zijn allemaal zaken waar de Nederlander niet op zit te wachten, maar diezelfde Nederlander krijgt wel de rekening gepresenteerd voor al deze plannen.","quote_context":"Kritiek op de Startnota en overheidsuitgaven","prompt_version":"0b12780c7cac","start_seconds":5091.241,"end_seconds":5120.021000000001,"actor":{"name":"Tony van Dijck","party":"PVV","role_title":null},"document":{"id":56885,"external_id":"2b5349f4-5156-4d9c-a8bd-7e7fe020ebc9","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T12:35:28","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=speaker2026-04-23T12%3A35%3A28%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"Er gaat dit jaar 8 miljard naar windmolens op zee","attributed_source_text":null},{"claim_text":"Opgeteld gaat er alleen dit jaar al 40 miljard belastinggeld door het putje","attributed_source_text":null}],"tags":[]},{"id":17848,"key":"8945599e813b","stance":"contra","typology":"economic","quote_text":"Waarom moet Nederland de hoogste accijns betalen op brandstof, de hoofdprijs betalen voor boodschappen, een recordprijs betalen voor een kuub gas, de hoogste prijs voor wonen, autorijden, verkeersboetes? Op al die punten zijn wij koploper, in het duurste land van Europa, terwijl ze zich in andere landen kapotlachen.","quote_context":"Kritiek op de hoge energieprijzen en belastingdruk in Nederland","prompt_version":"0b12780c7cac","start_seconds":5269.161,"end_seconds":5288.601000000001,"actor":{"name":"Tony van Dijck","party":"PVV","role_title":null},"document":{"id":56885,"external_id":"2b5349f4-5156-4d9c-a8bd-7e7fe020ebc9","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T12:35:28","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=speaker2026-04-23T12%3A35%3A28%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"Nederland betaalt de hoogste accijns op brandstof en een recordprijs voor een kuub gas","attributed_source_text":null},{"claim_text":"Nederland is het duurste land van Europa op deze punten","attributed_source_text":null}],"tags":[]},{"id":17842,"key":"83b7ed8995e5","stance":"contra","typology":"economic","quote_text":"De asielkosten lopen fors op. Dat blijkt ook uit de extra tegenvaller van een half miljard. Dat is, zoals bekend, geen incident, maar wel een trend, want zolang de instroom van asiel hoog blijft, zullen ook de kosten stijgen tot 9 miljard dit jaar, zegt de Voorjaarsnota. JA21 zegt: Nederland moet de regie gaan terugpakken, minder instroom, harde maatregelen, deals met partnerlanden buiten de EU, de voordeur dicht en de achterdeur open.","quote_context":"Eerdmans argumenteert voor strengere migratiebeleid op basis van de financiële druk die asielkosten uitoefenen op de begroting.","prompt_version":"0b12780c7cac","start_seconds":8301,"end_seconds":8323.320000000003,"actor":{"name":"Joost Eerdmans","party":"JA21","role_title":null},"document":{"id":57001,"external_id":"5a5e86f6-eaee-412a-8a3e-91a712eb0db4","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T13:30:55","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=speaker2026-04-23T13%3A30%3A55%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"extra tegenvaller van een half miljard","attributed_source_text":null},{"claim_text":"kosten stijgen tot 9 miljard dit jaar","attributed_source_text":"Voorjaarsnota"}],"tags":[]},{"id":17843,"key":"24906d1e8708","stance":"contra","typology":"factual","quote_text":"Mijn oproep aan het kabinet is dan ook vandaag concrete stappen te zetten naar herziening van het EVRM en naar returnhubs en opvang in de regio, en een einde te maken aan de Spreidingswet.","quote_context":"Eerdmans noemt specifieke beleidsmaatregelen die volgens hem nodig zijn om de instroom te beperken en de regie terug te pakken.","prompt_version":"0b12780c7cac","start_seconds":8341,"end_seconds":8348.66,"actor":{"name":"Joost Eerdmans","party":"JA21","role_title":null},"document":{"id":57001,"external_id":"5a5e86f6-eaee-412a-8a3e-91a712eb0db4","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/1d6146a9-714e-4104-a7ab-32a7c2107030/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10/video","published_at":"2026-04-23T13:30:55","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-23/financien/plenaire-zaal/voorjaarsnota-2026-36-915-nr-1-11-10?event=speaker2026-04-23T13%3A30%3A55%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-23/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-23T11%3A12%3A47%2B0200&end=2026-04-23T14%3A05%3A17%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]}]