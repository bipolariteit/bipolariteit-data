[{"id":9734,"stance":"pro","typology":"factual","quote_text":"Het offensief is er al, maar de financiering en uitvoering ontbreken. Dat laat het TNO-onderzoek ook zien. Er is echt nog heel veel ruimte voor verbetering. Dat voegt deze motie toe.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":440,"end_seconds":449.39999999999964,"actor":{"name":"Sjoukje van Oosterhout","party":"GroenLinks-PvdA","role_title":null},"document":{"id":35137,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/57079445-cce8-40c4-ba34-738bc61a14aa/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15/video","published_at":"2026-04-09T10:22:53","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15?event=speaker2026-04-09T10%3A22%3A53%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A02614","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-09/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-09T10%3A15%3A33%2B0200&end=2026-04-09T10%3A46%3A44%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"de financiering en uitvoering ontbreken","attributed_source_text":"TNO-onderzoek"}],"tags":[],"oppositions":[]},{"id":9735,"stance":"contra","typology":"factual","quote_text":"TNO zegt: de collectieve aanpak kan beter. Maar het offensief als zodanig hoeft er niet te komen; dat is er al. We hebben de komst van het mede door GroenLinks geïnitieerde programma gefinancierd met 4 miljard euro tot en met 2030. Tot en met 2030 is er dus genoeg financiering. Alleen na 2030 ontbreken de middelen. Mijn uitnodiging is dus om de motie specifieker te maken, zodat we ook na 2030 nog kunnen blijven isoleren.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":456,"end_seconds":480.54100000000017,"actor":{"name":"Pieter Grinwis","party":"ChristenUnie","role_title":null},"document":{"id":35139,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/57079445-cce8-40c4-ba34-738bc61a14aa/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15/video","published_at":"2026-04-09T10:23:09","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15?event=interrupter2026-04-09T10%3A23%3A09%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A02614","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-09/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-09T10%3A15%3A33%2B0200&end=2026-04-09T10%3A46%3A44%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"TNO zegt: de collectieve aanpak kan beter","attributed_source_text":"TNO"},{"claim_text":"We hebben de komst van het mede door GroenLinks geïnitieerde programma gefinancierd met 4 miljard euro tot en met 2030","attributed_source_text":null},{"claim_text":"Tot en met 2030 is er dus genoeg financiering","attributed_source_text":null},{"claim_text":"Alleen na 2030 ontbreken de middelen","attributed_source_text":null}],"tags":[],"oppositions":[]},{"id":9736,"stance":"pro","typology":"factual","quote_text":"We zitten op 80.000, maar als we 750.000 woningen willen halen in 2030, zullen we echt, echt, echt snelheid moeten maken.","quote_context":"Spreker benadrukt de noodzaak van versnelling bij isolatie om doelen te halen.","prompt_version":"0b12780c7cac","start_seconds":811.0400000000009,"end_seconds":817.8799999999992,"actor":{"name":"Hanneke Steen","party":"CDA","role_title":null},"document":{"id":35156,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/57079445-cce8-40c4-ba34-738bc61a14aa/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15/video","published_at":"2026-04-09T10:28:45","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15?event=speaker2026-04-09T10%3A28%3A45%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A02614","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-09/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-09T10%3A15%3A33%2B0200&end=2026-04-09T10%3A46%3A44%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"We zitten op 80.000","attributed_source_text":null},{"claim_text":"we 750.000 woningen willen halen in 2030","attributed_source_text":null}],"tags":[],"oppositions":[]},{"id":9737,"stance":"contra","typology":"factual","quote_text":"Verder denk ik dat we, als we echt een grote stap willen maken in het grotere geheel, ook echt heel slim moeten kijken naar hoe we onze regels vooral makkelijker kunnen maken, zodat we ook private partijen gelegenheid geven om die stap naar de verduurzaming te maken.","quote_context":"Spreker pleit voor regelontkoppeling en ruimte voor private partijen in plaats van overheidsdwang.","prompt_version":"0b12780c7cac","start_seconds":824.3189999999995,"end_seconds":838.2990000000009,"actor":{"name":"Hanneke Steen","party":"CDA","role_title":null},"document":{"id":35156,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/57079445-cce8-40c4-ba34-738bc61a14aa/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15/video","published_at":"2026-04-09T10:28:45","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15?event=speaker2026-04-09T10%3A28%3A45%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A02614","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-09/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-09T10%3A15%3A33%2B0200&end=2026-04-09T10%3A46%3A44%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[],"oppositions":[]},{"id":9738,"stance":"pro","typology":"economic","quote_text":"Deze maatregel is belangrijk, juist ook om de energierekening van huishoudens te verlagen en om perspectief te bieden.","quote_context":"Verdediging van de normering en stimulering van de energietransitie zoals afgesproken in het coalitieakkoord.","prompt_version":"0b12780c7cac","start_seconds":1244.2200000000012,"end_seconds":1250.1599999999999,"actor":{"name":"Elanor Boekholt-O'Sullivan","party":null,"role_title":"minister van Volkshuisvesting en Ruimtelijke Ordening"},"document":{"id":35159,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/57079445-cce8-40c4-ba34-738bc61a14aa/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15/video","published_at":"2026-04-09T10:36:00","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15?event=speaker2026-04-09T10%3A36%3A00%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A02614","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-09/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-09T10%3A15%3A33%2B0200&end=2026-04-09T10%3A46%3A44%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[],"oppositions":[]},{"id":9739,"stance":"contra","typology":"economic","quote_text":"Zoals in het debat ook is aangegeven, zijn er heel veel particuliere huishoudens die dit niet kunnen betalen of is het gewoon ook niet zinvol om te doen in slecht geïsoleerde woningen. Ook corporatiekoepel Aedes geeft dat aan.","quote_context":"Argument tegen normering/isolatieverplichting vanwege betaalbaarheid en zinvolheid","prompt_version":"0b12780c7cac","start_seconds":1274.42,"end_seconds":1287.3989999999994,"actor":{"name":"Jeremy Mooiman","party":"PVV","role_title":null},"document":{"id":35160,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/57079445-cce8-40c4-ba34-738bc61a14aa/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15/video","published_at":"2026-04-09T10:36:31","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15?event=interrupter2026-04-09T10%3A36%3A31%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A02614","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-09/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-09T10%3A15%3A33%2B0200&end=2026-04-09T10%3A46%3A44%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"heel veel particuliere huishoudens die dit niet kunnen betalen","attributed_source_text":null},{"claim_text":"het is niet zinvol om te doen in slecht geïsoleerde woningen","attributed_source_text":null},{"claim_text":"corporatiekoepel Aedes geeft dat aan","attributed_source_text":"corporatiekoepel Aedes"}],"tags":[],"oppositions":[]},{"id":9740,"stance":"pro","typology":"factual","quote_text":"Blijven verwarmen op aardgas is niet toekomstvast. Zie ook de huidige geopolitieke ontwikkelingen.","quote_context":"Toelichting bij het ontraden van een motie van de heer Mooiman","prompt_version":"0b12780c7cac","start_seconds":1335.0400000000009,"end_seconds":1340.2210000000014,"actor":{"name":"Elanor Boekholt-O'Sullivan","party":null,"role_title":"minister van Volkshuisvesting en Ruimtelijke Ordening"},"document":{"id":35163,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/57079445-cce8-40c4-ba34-738bc61a14aa/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15/video","published_at":"2026-04-09T10:37:39","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15?event=speaker2026-04-09T10%3A37%3A39%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A02614","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-09/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-09T10%3A15%3A33%2B0200&end=2026-04-09T10%3A46%3A44%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"Blijven verwarmen op aardgas is niet toekomstvast","attributed_source_text":null},{"claim_text":"huidige geopolitieke ontwikkelingen","attributed_source_text":null}],"tags":[],"oppositions":[]},{"id":9741,"stance":"contra","typology":"factual","quote_text":"Tegelijkertijd geven netbeheerders juist ook aan dat we in noodzakelijke gevallen nog van gas gebruik moeten kunnen maken. Het lijkt me dat dit een enorme oplossing kan bieden voor als het nodig is.","quote_context":"Spreker betoogt dat gas als back-up nodig is voor netcongestie, gebaseerd op uitspraken van netbeheerders.","prompt_version":"0b12780c7cac","start_seconds":1369.08,"end_seconds":1382.7799999999988,"actor":{"name":"Jeremy Mooiman","party":"PVV","role_title":null},"document":{"id":35165,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/57079445-cce8-40c4-ba34-738bc61a14aa/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15/video","published_at":"2026-04-09T10:38:04","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15?event=interrupter2026-04-09T10%3A38%3A04%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A02614","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-09/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-09T10%3A15%3A33%2B0200&end=2026-04-09T10%3A46%3A44%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"netbeheerders geven aan dat we in noodzakelijke gevallen nog van gas gebruik moeten kunnen maken","attributed_source_text":"netbeheerders"}],"tags":[],"oppositions":[]},{"id":9742,"stance":"contra","typology":"factual","quote_text":"Ik deel het doel dat deze motie nastreeft. Alleen, ik kan lokale eisen niet afschaffen. Ik heb u recent nog geschreven hoe ik de EPBD-eisen over CO2 en energiezuinigheid ga invoeren. Die lijn gaat uit van landelijke regels, die overal in Nederland gelden.","quote_context":"De minister verwerpt de mogelijkheid om lokale eisen af te schaffen ten gunste van landelijke regels, wat wijst op voorkeur voor centrale sturing.","prompt_version":"0b12780c7cac","start_seconds":1429,"end_seconds":1446.9166666666667,"actor":{"name":"Elanor Boekholt-O'Sullivan","party":null,"role_title":"minister van Volkshuisvesting en Ruimtelijke Ordening"},"document":{"id":35174,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/57079445-cce8-40c4-ba34-738bc61a14aa/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15/video","published_at":"2026-04-09T10:39:22","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15?event=speaker2026-04-09T10%3A39%3A22%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A02614","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-09/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-09T10%3A15%3A33%2B0200&end=2026-04-09T10%3A46%3A44%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"EPBD-eisen over CO2 en energiezuinigheid worden ingevoerd via landelijke regels die overal in Nederland gelden","attributed_source_text":null}],"tags":[],"oppositions":[]},{"id":9744,"stance":"contra","typology":"factual","quote_text":"De overheid heeft gezegd tegen mensen dat ze zonnepanelen zouden moeten nemen, want dat zou duurzaam, goed en ook nog goed voor de energierekening zijn. Nu is de salderingsregeling afgeschaft — of die wordt eigenlijk per 1 januari 2027 afgeschaft — en tegelijkertijd wil dit kabinet een heleboel andere duurzaamheidsmaatregelen nemen. Snapt het kabinet ook wat dat doet met het vertrouwen? Eerst is mensen namelijk geadviseerd zonnepanelen te nemen om iets te doen voor de planeet, maar ook voor de eigen rekening. Vervolgens krijgen ze een rekening gepresenteerd. En dan klopt de overheid opnieuw aan de deur: we hebben nog een set maatregelen, maar nee, nee, nee, maakt u zich geen zorgen, want dit keer is het echt goed voor uw rekening. Snapt de minister dat het draagvlak echt weg is als je op deze manier met mensen omgaat?","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":1722.621000000001,"end_seconds":1765.7810000000009,"actor":{"name":"Sandra Beckerman","party":"SP","role_title":null},"document":{"id":35198,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/57079445-cce8-40c4-ba34-738bc61a14aa/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15/video","published_at":"2026-04-09T10:44:12","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15?event=interrupter2026-04-09T10%3A44%3A12%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A02614","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-09/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-09T10%3A15%3A33%2B0200&end=2026-04-09T10%3A46%3A44%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"De overheid heeft gezegd tegen mensen dat ze zonnepanelen zouden moeten nemen, want dat zou duurzaam, goed en ook nog goed voor de energierekening zijn.","attributed_source_text":null},{"claim_text":"de salderingsregeling afgeschaft — of die wordt eigenlijk per 1 januari 2027 afgeschaft","attributed_source_text":null}],"tags":[],"oppositions":[]},{"id":9745,"stance":"contra","typology":"economic","quote_text":"Zeker huurders hebben heel weinig kunnen profiteren van de salderingsregeling, maar gaan er echt hard op achteruit, zelfs volgens de berekening van het ministerie zelf. Daar moet je toch een oplossing voor kunnen vinden, zeker omdat je de budgetten hébt en je deze mensen echt nodig hebt voor al je plannen?","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":1810.5789999999997,"end_seconds":1829,"actor":{"name":"Sandra Beckerman","party":"SP","role_title":null},"document":{"id":35201,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/57079445-cce8-40c4-ba34-738bc61a14aa/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15/video","published_at":"2026-04-09T10:45:32","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-09/huisvesting/plenaire-zaal/tweeminutendebat-klimaatbeleid-gebouwde-omgeving-cd-25-3-10-15?event=interrupter2026-04-09T10%3A45%3A32%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A02614","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-09/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-09T10%3A15%3A33%2B0200&end=2026-04-09T10%3A46%3A44%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"huurders gaan hard op achteruit door de afbouw van de salderingsregeling","attributed_source_text":"berekening van het ministerie zelf"}],"tags":[],"oppositions":[]}]