[{"id":19247,"key":"e72150920d9f","stance":"contra","typology":"factual","quote_text":"Waarom negeert het kabinet een aangenomen motie, gesteund door onder andere D66 en het CDA, waarin wordt verzocht om de hulp voor Oekraïne niet uit dit budget te halen? Die 419 miljoen euro voor Oekraïne is 419 miljoen euro minder voor andere acute crises. Ook mijn fractie wil natuurlijk steun voor Oekraïne, maar niet uit dit potje.","quote_context":"De spreker bekritiseert de financiering van de Oekraïne-hulp uit het budget voor noodhulp, omdat dit ten koste gaat van hulp aan andere crises.","prompt_version":"0b12780c7cac","start_seconds":683.1199999999999,"end_seconds":708.2800000000002,"actor":{"name":"Suzanne Kröger","party":"GroenLinks-PvdA","role_title":null},"document":{"id":231334,"external_id":"564bb70a-37a9-4bbb-b656-e48ee30094e4","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/efe509ca-3f01-4264-af54-58d52fd2c90b/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-01/internationaal/suze-groenewegzaal/humanitaire-hulp-10-00/video","published_at":"2026-04-01T10:12:56","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-01/internationaal/suze-groenewegzaal/humanitaire-hulp-10-00?event=speaker2026-04-01T10%3A12%3A56%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-01/suzegroenewegzaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-01T10%3A02%3A45%2B0200&end=2026-04-01T13%3A00%3A44%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"Er is een aangenomen motie, gesteund door onder andere D66 en het CDA, waarin wordt verzocht om de hulp voor Oekraïne niet uit dit budget te halen.","attributed_source_text":null},{"claim_text":"De 419 miljoen euro voor Oekraïne is 419 miljoen euro minder voor andere acute crises.","attributed_source_text":null}],"tags":[]},{"id":19236,"key":"bc5e4530c501","stance":"unclear","t