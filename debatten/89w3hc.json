[{"id":19497,"key":"58820ec42264","stance":"pro","typology":"factual","quote_text":"Voor ons staat één punt voorop: de veiligheid van ons continent staat of valt met de veiligheid van Oekraïne. Daarom steunen wij het dat Nederland inzet op die snelle doorgang van de Europese lening van 90 miljard euro ter ondersteuning, op extra militaire en niet-militaire steun en op een verdere druk op Rusland via een twintigste sanctiepakket.","quote_context":"Krul benadrukt de noodzaak van steun aan Oekraïne voor de Europese veiligheid.","prompt_version":"68f9cad51b33","start_seconds":2666.040000000001,"end_seconds":2684.9190000000017,"actor":{"name":"Harmen Krul","party":"CDA","role_title":null},"document":{"id":87528,"external_id":"91109a0a-d954-4865-a3f0-b8207f10f0e4","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T20:42:19","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T20%3A42%3A19%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"Europese lening van 90 miljard euro","attributed_source_text":null}],"tags":[]},{"id":19498,"key":"048cf8f11269","stance":"pro","typology":"moral","quote_text":"Vrede kan nooit over de hoofden van de Oekraïners heen worden geregeld. Duurzame vrede bestaat alleen als Oekraïne zelf instemt met de uitkomst van onderhandelingen. Dat is niet alleen moreel juist, maar zeker ook in ons eigen veiligheidsbelang.","quote_context":"Krul pleit voor de soevereiniteit van Oekraïne in vredesonderhandelingen.","prompt_version":"68f9cad51b33","start_seconds":2688.6800000000003,"end_seconds":2702.220000000001,"actor":{"name":"Harmen Krul","party":"CDA","role_title":null},"document":{"id":87528,"external_id":"91109a0a-d954-4865-a3f0-b8207f10f0e4","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T20:42:19","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T20%3A42%3A19%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19500,"key":"6ecbee023737","stance":"pro","typology":"factual","quote_text":"Ziet de minister-president hier een kans om de afspraken uit het regeerakkoord om unanimiteit bij het nemen van besluiten over Gemeenschappelijk Buitenlands en Veiligheidsbeleid af te schaffen?","quote_context":"Spreker Maes vraagt of de premier de unanimiteitsregel in het GBVB wil afschaffen om blokkades door individuele lidstaten zoals Hongarije te voorkomen.","prompt_version":"68f9cad51b33","start_seconds":3310,"end_seconds":3321.25,"actor":{"name":"Nicole Maes","party":"VVD","role_title":null},"document":{"id":87550,"external_id":"303cb4d2-95e2-4c76-8406-8e2a200eb4ec","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T20:54:46","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T20%3A54%3A46%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19499,"key":"d1467ef3e921","stance":"pro","typology":"factual","quote_text":"Het is wat mij betreft van levensbelang dat de EU snel uit de impasse komt, vooral wat betreft de financiële steun voor Oekraïne; dat is al een aantal malen gezegd. Voor de VVD-fractie was het besluit op de Europese Raad in december niet de ideale uitkomst, maar het was wel een besluit van alle 27 lidstaten. Daarom vindt mijn fractie het onbegrijpelijk dat Orbán hier nu op terugkomt. Wat is de minister-president van plan te doen om te zorgen dat Hongarije zich volgende week alsnog achter het genomen besluit schaart?","quote_context":"Spreker Maes pleit voor snelle EU-financiële steun aan Oekraïne en kritiseert Hongarije voor het blokkeren van eerdere besluiten.","prompt_version":"68f9cad51b33","start_seconds":3492.2790000000023,"end_seconds":3522.959999999999,"actor":{"name":"Nicole Maes","party":"VVD","role_title":null},"document":{"id":87550,"external_id":"303cb4d2-95e2-4c76-8406-8e2a200eb4ec","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T20:54:46","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T20%3A54%3A46%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"het was wel een besluit van alle 27 lidstaten","attributed_source_text":null}],"tags":[]},{"id":19495,"key":"ec32a58de8ab","stance":"contra","typology":"economic","quote_text":"Ik vraag dus aan de premier: maak niet nog meer geld over aan Oekraïne, maar help die Nederlander nou eens een keer, de gepensioneerde aan de keukentafel, de ondernemer die zucht onder de torenhoge lasten, de huurder die geen huis vindt. Besteed Nederlands geld aan de Nederlanders en laat andere Europese landen nu eens de gaten dichtlopen die ze zelf hebben laten vallen in de steun richting Oekraïne.","quote_context":"Kritiek op de prioriteit van de premier voor Oekraïne ten koste van de Nederlandse bevolking.","prompt_version":"68f9cad51b33","start_seconds":4185.199999999997,"end_seconds":4208.180999999997,"actor":{"name":"Sebastiaan Stöteler","party":"PVV","role_title":null},"document":{"id":87555,"external_id":"f3f9466a-b988-4452-9612-9198d1f2fedc","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:07:44","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A07%3A44%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19496,"key":"aa711d5a9c0c","stance":"contra","typology":"factual","quote_text":"Voor de PVV is het glashelder: geen EU-lidmaatschap voor Oekraïne, geen lidmaatschap-light, geen achterdeurtjes en geen proefballonnen uit Brussel.","quote_context":"Standpunt van de PVV-fractie over de toetreding van Oekraïne tot de EU.","prompt_version":"68f9cad51b33","start_seconds":4209.080000000002,"end_seconds":4218.159999999996,"actor":{"name":"Sebastiaan Stöteler","party":"PVV","role_title":null},"document":{"id":87555,"external_id":"f3f9466a-b988-4452-9612-9198d1f2fedc","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:07:44","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A07%3A44%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19501,"key":"d7c3066e2394","stance":"contra","typology":"factual","quote_text":"Sinds het aantreden van het kabinet zijn al drie ministers, waaronder de minister-president, naar Oekraïne gereisd, terwijl er hier in Nederland miljoenen mensen zijn die ook met grote uitdagingen worstelen. Mensen die moeite hebben hun rekeningen te betalen, ondernemers en boeren die hun levenswerk zien verdwijnen, en inwoners in de regio die hun omgeving zien verschralen en het gevoel hebben dat hun leefwereld steeds verder onder druk staat. De minister van Landbouw wilde niet eens een kwartiertje spreken bij de manifestatie Red het Platteland, afgelopen weekend. Wat voor signaal geven we dan af aan al die mensen als vrijwel het eerste wat zij zien, is dat de ministers massaal naar Oekraïne trekken? Waar ligt dan de prioriteit van dit kabinet? Voor veel mensen versterkt dat precies het gevoel dat Europa en Den Haag soms ver afstaan van hun eigen werkelijkheid.","quote_context":"Kritiek op de prioriteitenstelling van het kabinet ten aanzien van binnenlandse problemen versus internationale steun aan Oekraïne.","prompt_version":"68f9cad51b33","start_seconds":4454.739999999998,"end_seconds":4505.021000000001,"actor":{"name":"Henk Vermeer","party":"BBB","role_title":null},"document":{"id":87557,"external_id":"24aab457-3360-4acf-8cd1-888fe6cbd8ea","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:12:16","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A12%3A16%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"Sinds het aantreden van het kabinet zijn al drie ministers, waaronder de minister-president, naar Oekraïne gereisd","attributed_source_text":null},{"claim_text":"De minister van Landbouw wilde niet eens een kwartiertje spreken bij de manifestatie Red het Platteland, afgelopen weekend","attributed_source_text":null}],"tags":[]},{"id":19502,"key":"8fc679e87be2","stance":"contra","typology":"legal","quote_text":"Hoe kijkt de minister-president naar de steeds hardere toon van president Zelensky richting Hongarije en premier Orbán, inclusief berichten over druk en dreiging richting Hongarije wanneer het land zijn veto gebruikt? Vindt de minister-president dat een gezonde manier van samenwerken binnen Europa? Kan hij hier bevestigen dat Nederland staat voor een Europese Unie, waarin lidstaten hun verdragsrechtelijke veto vrij kunnen gebruiken, zonder politieke druk of zelfs militaire dreiging?","quote_context":"Kritiek op de retoriek van Zelensky richting Hongarije en verzoek om bevestiging van het Nederlandse standpunt over het veto-recht.","prompt_version":"68f9cad51b33","start_seconds":4583.5,"end_seconds":4612.419999999998,"actor":{"name":"Henk Vermeer","party":"BBB","role_title":null},"document":{"id":87557,"external_id":"24aab457-3360-4acf-8cd1-888fe6cbd8ea","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:12:16","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A12%3A16%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"president Zelensky richting Hongarije en premier Orbán, inclusief berichten over druk en dreiging richting Hongarije wanneer het land zijn veto gebruikt","attributed_source_text":null}],"tags":[]},{"id":19480,"key":"db15b93ddb84","stance":"pro","typology":"factual","quote_text":"Ik zag daar de schade die is toegebracht aan de energie-infrastructuur en aan woonwijken, de vreselijke winter die de Oekraïners hebben moeten doormaken, de opluchting dat de lente nu was aangebroken. Tegelijkertijd is er ook het besef dat door de oorlog in Iran het risico op minder aandacht voor Oekraïne gigantisch is en dat dat de strijd van Oekraïne enorm onder druk kan zetten. Daarna had ik ook mijn bezoek aan Polen, waarbij de Poolse premier mij nogmaals op het hart drukte dat als Oekraïne valt, Europa daarna de volgende in de rij is. Dit is dus niet alleen de oorlog van Oekraïne; het is ook de oorlog die gaat over de Europese normen en waarden en over de Europese vrijheid en veiligheid.","quote_context":"Jetten beschrijft zijn recente bezoek aan Oekraïne en Polen en de conclusies die hij daaruit trekt voor de Europese veiligheid.","prompt_version":"68f9cad51b33","start_seconds":5864.300000000003,"end_seconds":5904.040000000001,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87570,"external_id":"c79dbce5-f472-4dc1-85ae-630526d0ff41","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:34:52","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A34%3A52%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"de Poolse premier mij nogmaals op het hart drukte dat als Oekraïne valt, Europa daarna de volgende in de rij is","attributed_source_text":"de Poolse premier"}],"tags":[]},{"id":19490,"key":"2b6b56b402b7","stance":"pro","typology":"moral","quote_text":"Over Oekraïne zei ik net al: zij vechten niet alleen voor hun eigen veiligheid en vrijheid, maar ook voor die van ons. Zij verdienen daarom onze onverminderde steun.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":5920,"end_seconds":5932.398999999998,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87572,"external_id":"6581ddac-7cae-4a2e-9672-8c90ad2dfc82","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:38:16","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A38%3A16%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19491,"key":"f07355552a62","stance":"pro","typology":"factual","quote_text":"Het kabinet blijft de Amerikaanse initiatieven tot onderhandelingen aanmoedigen, maar de eerlijkheid gebiedt ook te zeggen dat we aan Russische zijde geen enkele bereidheid zien om die onderhandelingen daadwerkelijk te laten slagen. Dat betekent dat Oekraïne de komende tijd zowel op militair als op non-militair vlak forse steun nodig zal hebben om de strijd tegen Rusland voort te kunnen zetten.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":5927.719999999994,"end_seconds":5953.419999999998,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87572,"external_id":"6581ddac-7cae-4a2e-9672-8c90ad2dfc82","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:38:16","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A38%3A16%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19492,"key":"4366a5228e21","stance":"pro","typology":"factual","quote_text":"Nederland doet heel veel en dat is goed; het is ook goed dat we daar de komende jaren meerjarig geld voor uittrekken, maar ook andere landen moeten hun verantwoordelijkheid nemen en meer doen dan ze tot nu toe hebben gedaan, zodat we een eerlijke verdeling van de lasten hebben.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":5954.219999999994,"end_seconds":5971.639999999999,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87572,"external_id":"6581ddac-7cae-4a2e-9672-8c90ad2dfc82","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:38:16","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A38%3A16%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19493,"key":"5c52d31e8219","stance":"pro","typology":"factual","quote_text":"Dat geldt ook voor de lening van 90 miljard die is afgesproken. Dat is een positieve stap om Oekraïne de komende tijd stevig te kunnen helpen. Die lening moet ook daadwerkelijk worden voortgezet.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":5973.778999999995,"end_seconds":5986.0999999999985,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87572,"external_id":"6581ddac-7cae-4a2e-9672-8c90ad2dfc82","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:38:16","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A38%3A16%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"lending of 90 miljard","attributed_source_text":null}],"tags":[]},{"id":19494,"key":"8a006cb31cdf","stance":"pro","typology":"factual","quote_text":"Er is een politiek akkoord gesloten. Ook Hongarije heeft daarmee ingestemd. De blokkade die nu achteraf plaatsvindt, is echt onacceptabel. Ik ga ervan uit dat de Europese Commissie er alles aan doet om een oplossing hiervoor te vinden.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":5991.1990000000005,"end_seconds":6004.578999999998,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87572,"external_id":"6581ddac-7cae-4a2e-9672-8c90ad2dfc82","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:38:16","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A38%3A16%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"Er is een politiek akkoord gesloten","attributed_source_text":null},{"claim_text":"Ook Hongarije heeft daarmee ingestemd","attributed_source_text":null}],"tags":[]},{"id":19485,"key":"ad7718093b0e","stance":"pro","typology":"factual","quote_text":"Naast die 90 miljard euro is het belangrijk dat we het twintigste sanctiepakket tegen Rusland zo snel mogelijk aannemen, zodat we aanvullende maatregelen kunnen nemen tegen de Russische militair- industriële complexen, tegen de Russische schaduwvloot en zodat we omzeiling via derde landen beter kunnen aanpakken.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":6028.200000000004,"end_seconds":6045.981,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87574,"external_id":"53e8e6ae-c11a-4811-a62b-79ba5287e971","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:39:59","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A39%3A59%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19486,"key":"46f3c186e36a","stance":"pro","typology":"moral","quote_text":"We moeten ook vaart houden in het EU-toetredingsproces, omdat dat belangrijk is als perspectief voor het Oekraïense volk. Zij willen graag weten of alle offers die zij nu brengen, straks ook daadwerkelijk iets waard zijn.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":6046.4200000000055,"end_seconds":6058,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87574,"external_id":"53e8e6ae-c11a-4811-a62b-79ba5287e971","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:39:59","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A39%3A59%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19487,"key":"fa12db7e218d","stance":"pro","typology":"factual","quote_text":"Ik vind het zelf eerlijk gezegd niet behulpzaam om nu te gaan speculeren over dat soort alternatieven, omdat het ook de druk op Hongarije verlicht. Die druk moet nu maximaal worden opgevoerd.","quote_context":"Betreft de blokkade van de 90 miljard euro door Hongarije","prompt_version":"68f9cad51b33","start_seconds":6132.940999999999,"end_seconds":6143.1600000000035,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87574,"external_id":"53e8e6ae-c11a-4811-a62b-79ba5287e971","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:39:59","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A39%3A59%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19488,"key":"59c5e7f6b7fa","stance":"pro","typology":"factual","quote_text":"Ook andere landen zullen dus meer moeten doen om Oekraïne financieel op militair en non-militair gebied te ondersteunen.","quote_context":"Betreft burden sharing","prompt_version":"68f9cad51b33","start_seconds":6305.281000000003,"end_seconds":6312.181000000004,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87574,"external_id":"53e8e6ae-c11a-4811-a62b-79ba5287e971","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:39:59","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A39%3A59%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19489,"key":"ebf8c0a5c034","stance":"pro","typology":"moral","quote_text":"Ten aanzien van de reizen naar Oekraïne zou ik tegen de heer Vermeer willen aangeven dat juist in het licht van de oorlog in het Midden-Oosten het extra belangrijk is dat we onderstrepen dat we die Oekraïneoorlog niet uit het oog verliezen. De morele steun van de bezoeken aan Oekraïne wordt daar enorm gewaardeerd, maar het is ook een signaal aan onze partners binnen en buiten Europa dat de levering van noodzakelijke wapens bijvoorbeeld moet doorgaan en dat Nederland dus ook klaarstaat om met Oekraïne die samenwerking vorm te blijven geven.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":6344,"end_seconds":6376.261000000006,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87574,"external_id":"53e8e6ae-c11a-4811-a62b-79ba5287e971","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:39:59","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A39%3A59%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19476,"key":"93a5e3e9dbd6","stance":"pro","typology":"factual","quote_text":"Ik heb me ook door Zelensky laten bijpraten over hoe moeilijk het voor hen is om dit soort cruciale energie-infrastructuur te beveiligen tegen continue Russische aanvallen die daar plaatsvinden. Ik begrijp dus ook dat hij vervolgens de hulpvraag stelt. Hij kan niet in zijn eentje al die infrastructuur veilig bewaken voor Europa.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":6490.219999999994,"end_seconds":6511.398999999998,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87577,"external_id":"1a906ca0-0a00-4d7e-9efc-42140eadc291","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:47:19","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A47%3A19%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"continue Russische aanvallen die daar plaatsvinden","attributed_source_text":null}],"tags":[]},{"id":19475,"key":"aa0a1ec05776","stance":"pro","typology":"factual","quote_text":"We hebben al gezien dat Trump de sancties verlicht heeft als het gaat om de olieverkopen van Rusland aan India. Er ligt een twintigste sanctiepakket voor. Is het niet belangrijk om ook naar andere sancties te kijken voor Rusland? Ik doel dan specifiek op kunstmest.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":6789.278999999995,"end_seconds":6813.5,"actor":{"name":"Tom van der Lee","party":"GroenLinks-PvdA","role_title":null},"document":{"id":87584,"external_id":"5f4f59d0-ab7f-4383-b24e-42ab10a3accb","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:52:26","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=interrupter2026-03-12T21%3A52%3A26%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"Trump de sancties verlicht heeft als het gaat om de olieverkopen van Rusland aan India","attributed_source_text":null},{"claim_text":"Er ligt een twintigste sanctiepakket voor","attributed_source_text":null}],"tags":[]},{"id":19477,"key":"8edec11bdf57","stance":"pro","typology":"factual","quote_text":"Ik maak me wel echt zorgen over niet alleen de signalen over maar ook het daadwerkelijk toestaan van het omzeilen van sancties op Rusland in reactie op de oorlog in Iran. Dat zou echt heel slecht nieuws zijn omdat daarmee de oorlogskas van Poetin gewoon weer makkelijker wordt gevuld. Des te meer reden om dat twintigste sanctiepakket meteen in te zetten.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":6811,"end_seconds":6833.120000000003,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87585,"external_id":"31b0edcf-0455-445d-9e65-6501143a802c","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:53:07","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A53%3A07%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19478,"key":"382c9478153d","stance":"pro","typology":"factual","quote_text":"We krijgen ook steeds meer signalen dat de Russische economie heel slecht draait en dat wat dat betreft de onrust aan Russische zijde toeneemt. Des te meer reden om de druk te blijven opvoeren.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":6833.18,"end_seconds":6844.080000000002,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87585,"external_id":"31b0edcf-0455-445d-9e65-6501143a802c","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:53:07","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A53%3A07%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"steeds meer signalen dat de Russische economie heel slecht draait","attributed_source_text":null},{"claim_text":"de onrust aan Russische zijde toeneemt","attributed_source_text":null}],"tags":[]},{"id":19479,"key":"8c67e1acffb1","stance":"pro","typology":"factual","quote_text":"Wat mij betreft zal Nederland altijd in de kopgroep blijven zitten om te kijken of je na het 20ste sanctiepakket alvast kunt doorwerken aan het 21ste. Ik sta open voor alle suggesties voor sancties die daaraan kunnen worden toegevoegd.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":6844.9389999999985,"end_seconds":6856.879999999997,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87585,"external_id":"31b0edcf-0455-445d-9e65-6501143a802c","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T21:53:07","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T21%3A53%3A07%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-03-12/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-03-12T19%3A59%3A36%2B0100&end=2026-03-12T23%3A17%3A21%2B0100"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":19474,"key":"4efe60de0585","stance":"pro","typology":"factual","quote_text":"Eigenlijk iedereen in Europa vond het logisch dat je ook in andere sectoren een prijs op CO2-uitstoot zet, mits je maar een deel van de opbrengsten terug investeert in een goede transitie en daarbij ook extra aandacht besteedt aan gebieden of sectoren die meer moeite hebben om die transitie mee te maken.","quote_context":null,"prompt_version":"68f9cad51b33","start_seconds":8987,"end_seconds":9008.666666666666,"actor":{"name":"Rob Jetten","party":"D66","role_title":"minister-president, minister van Algemene Zaken"},"document":{"id":87635,"external_id":"afef58fe-8292-49ee-a9c0-f3b2d3441189","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/9fde93f2-af22-4477-9425-0aa47dfa26ae/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00/video","published_at":"2026-03-12T22:29:23","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-03-12/internationaal/plenaire-zaal/europese-top-van-19-en-20-maart-2026-17-00?event=speaker2026-03-12T22%3A29%3A23%2B0100","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b