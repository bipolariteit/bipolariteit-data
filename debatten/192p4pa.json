[{"id":17634,"key":"f9b75807d7ce","stance":"contra","typology":"factual","quote_text":"Ik ben met de minister bij een boer op bezoek geweest die minder dan 100 kilogram stikstof per hectare gebruikt. Die kan er prima van leven. In Nederland kan je met 170 kilogram prima je land onderhouden. Waarom maakt de heer Flach de boeren in Nederland zo afhankelijk van mest? Het lijkt soms wel een soort mestverslaving.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":810,"end_seconds":831.281,"actor":{"name":"Laura Bromet","party":"GroenLinks-PvdA","role_title":null},"document":{"id":97908,"external_id":"372bb047-9ee5-44db-8dae-4ebf005fccf9","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/d23a87cc-1d08-483f-9529-9524983ae793/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-05-21/internationaal/plenaire-zaal/onder-voorbehoud-landbouw-en-visserijraad-van-26-mei-2026-10-17/video","published_at":"2026-05-21T10:28:47","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-05-21/internationaal/plenaire-zaal/onder-voorbehoud-landbouw-en-visserijraad-van-26-mei-2026-10-17?event=interrupter2026-05-21T10%3A28%3A47%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-05-21/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-05-21T10%3A15%3A17%2B0200&end=2026-05-21T10%3A55%3A41%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"een boer die minder dan 100 kilogram stikstof per hectare gebruikt kan er prima van leven","attributed_source_text":null},{"claim_text":"in Nederland kan je met 170 kilogram prima je land onderhouden","attributed_source_text":null}],"tags":[]}]