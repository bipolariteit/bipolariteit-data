.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":499.39900000000125,"end_seconds":510.89900000000125,"actor":{"name":"Jeremy Mooiman","party":"PVV","role_title":null},"document":{"id":37693,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8b42fd98-b234-44d1-9e46-0cd797388ce5/resource","video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15/video","published_at":"2024-10-03T18:23:38","speaker_video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15?event=speaker2024-10-03T18%3A23%3A38%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/commissievergaderingen/details?id=2024A05865","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2024-10-03/groenvanprinstererzaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2024-10-03T18%3A16%3A17%2B0200&end=2024-10-03T21%3A25%3A58%2B0200"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Schoof"},"claims":[],"tags":[],"oppositions":[]},{"id":10183,"stance":"contra","typology":"economic","quote_text":"Het kabinet zet wel in op isolatieprogramma's. Hiermee worden woningeigenaren en woningen van verenigingen van eigenaren ondersteund die extra hulp nodig hebben bij het isoleren van de woningen om ook zo de energierekening verder omlaag te brengen. Dat is een goede zaak.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":511.9400000000023,"end_seconds":526.880000000001,"actor":{"name":"Jeremy Mooiman","party":"PVV","role_title":null},"document":{"id":37693,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8b42fd98-b234-44d1-9e46-0cd797388ce5/resource","video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-