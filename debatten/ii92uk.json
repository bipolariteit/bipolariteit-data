A16%3A17%2B0200&end=2024-10-03T21%3A25%3A58%2B0200"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Schoof"},"claims":[{"claim_text":"isolatie moeizaam verloopt vanwege de regelgeving omtrent beschermde soorten die in de spouwmuren verblijven","attributed_source_text":null}],"tags":[],"oppositions":[]},{"id":10185,"stance":"contra","typology":"factual","quote_text":"Dat er gekeken wordt naar klimaatadaptatie kan onze fractie zich voorstellen, maar het is ook van belang dat klimaatadaptatie geen extra belemmeringen oplevert voor de woningbouwopgave.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":616.760000000002,"end_seconds":628.8190000000031,"actor":{"name":"Jeremy Mooiman","party":"PVV","role_title":null},"document":{"id":37693,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8b42fd98-b234-44d1-9e46-0cd797388ce5/resource","video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15/video","published_at":"2024-10-03T18:23:38","speaker_video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15?event=speaker2024-10-03T18%3A23%3A38%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/commissievergaderingen/details?id=2024A05865","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2024-10-03/groenvanprinstererzaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2024-10-03T18%3A16%3A17%2B0200&end=2024-10-03T21%3A25%3A58%2B0200"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Schoof"},"claims":[],"tags":[],"oppositions":[]},{"id":10186,"stance":"contra","typology":"factual","quote_text":"Zo is ook in het regeerakkoord opgenomen dat dit kabinet geen extra duurzaamheidsregels voor de woningbouw oplegt.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":629.880000000001,"end_seconds":637.3190000000031,"actor":{"name":"Jeremy Mooiman","party":"PVV","role_title":null},"document":{"id":37693,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8b42fd98-b234-44d1-9e46-0cd797388ce5/resource","video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15/video","published_at":"2024-10-03T18:23:38","speaker_video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15?event=speaker2024-10-03T18%3A23%3A38%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/commissievergaderingen/details?id=2024A05865","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2024-10-03/groenvanprinstererzaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2024-10-03T18%3A16%3A17%2B0200&end=2024-10-03T21%3A25%3A58%2B0200"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Schoof"},"claims":[],"tags":[],"oppositions":[]},{"id":10187,"stance":"contra","typology":"economic","quote_text":"Ik wil de minister daarom oproepen om ten aanzien van duurzaamheidsmaatregelen altijd oog te houden voor de uitvoerbaarheid en betaalbaarheid zodat deze geen verdere lasten voor burgers opleveren of de woningbouwopgave vertragen.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":655.979000000003,"end_seconds":666.599000000002,"actor":{"name":"Jeremy Mooiman","party":"PVV","role_title":null},"document":{"id":37693,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8b42fd98-b234-44d1-9e46-0cd797388ce5/resource","video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15/video","published_at":"2024-10-03T18:23:38","speaker_video_url":"https