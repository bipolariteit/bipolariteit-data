[{"id":10176,"stance":"pro","typology":"moral","quote_text":"De geest van de toekomst zal met een zeis van memento mori aangeven dat deze transitie simpelweg moet lukken. Het is onze collectieve footprint en die moet omlaag om toekomstige generaties ook een mooi leven te gunnen. Dat betekent dat standaardisatie en opschaling letterlijk van levensbelang zijn. De transitie moet genormeerd worden zodat die stuurbaar wordt.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":247.6790000000001,"end_seconds":269.2400000000016,"actor":{"name":"Merlien Welzijn","party":"NSC","role_title":null},"document":{"id":37691,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8b42fd98-b234-44d1-9e46-0cd797388ce5/resource","video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15/video","published_at":"2024-10-03T18:17:08","speaker_video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15?event=speaker2024-10-03T18%3A17%3A08%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/commissievergaderingen/details?id=2024A05865","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2024-10-03/groenvanprinstererzaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2024-10-03T18%3A16%3A17%2B0200&end=2024-10-03T21%3A25%3A58%2B0200"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Schoof"},"claims":[],"tags":[],"oppositions":[]},{"id":10178,"stance":"pro","typology":"factual","quote_text":"In Europees verband zit er van alles aan te komen, maar als wij eigen ervaringen hebben, kunnen wij in Europees verband beter meedenken en meedoen met wat er gaande is, en dat ook beïnvloeden.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":387.89900000000125,"end_seconds":400.4200000000019,"actor":{"name":"Merlien Welzijn","party":"NSC","role_title":null},"document":{"id":37691,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8b42fd98-b234-44d1-9e46-0cd797388ce5/resource","video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15/video","published_at":"2024-10-03T18:17:08","speaker_video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15?event=speaker2024-10-03T18%3A17%3A08%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/commissievergaderingen/details?id=2024A05865","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2024-10-03/groenvanprinstererzaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2024-10-03T18%3A16%3A17%2B0200&end=2024-10-03T21%3A25%3A58%2B0200"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Schoof"},"claims":[{"claim_text":"In Europees verband zit er van alles aan te komen.","attributed_source_text":null}],"tags":[],"oppositions":[]},{"id":10179,"stance":"contra","typology":"economic","quote_text":"Voor de PVV is het daarbij van belang dat maatregelen die worden genomen ter invulling van deze opgave ook daadwerkelijk voordelen opleveren voor inwoners en bedrijven, bijvoorbeeld verlaging van de kosten. Bij de aanpak dienen we een goede dosis realisme en nuchterheid te hanteren en te zorgen dat zaken betaalbaar blijven zonder te veel stringente regelgeving op te leggen.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":455.07900000000154,"end_seconds":476.8600000000006,"actor":{"name":"Jeremy Mooiman","party":"PVV","role_title":null},"document":{"id":37693,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8b42fd98-b234-44d1-9e46-0cd797388ce5/resource","video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15/video","published_at":"2024-10-03T18:23:38","speaker_video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15?event=speaker2024-10-03T18%3A23%3A38%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/commissievergaderingen/details?id=2024A05865","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2024-10-03/groenvanprinstererzaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2024-10-03T18%3A16%3A17%2B0200&end=2024-10-03T21%3A25%3A58%2B0200"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Schoof"},"claims":[],"tags":[],"oppositions":[]},{"id":10180,"stance":"contra","typology":"economic","quote_text":"Wat ons betreft gaat de eerdergenoemde opgave hand in hand met het nemen van maatregelen om ervoor te zorgen dat de energierekening van burgers naar beneden gaat, zodat duurzaam niet alleen maar heel erg duur wordt, maar ook daadwerkelijk voordeel oplevert.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":477.95900000000256,"end_seconds":491.63900000000285,"actor":{"name":"Jeremy Mooiman","party":"PVV","role_title":null},"document":{"id":37693,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8b42fd98-b234-44d1-9e46-0cd797388ce5/resource","video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15/video","published_at":"2024-10-03T18:23:38","speaker_video_url":"https://debatdirect.tweedekamer.nl/2024-10-03/landbouw-natuur-voedselkwaliteit/groen-van-prinstererzaal/klimaatakkoord-gebouwde-omgeving-18-15?event=speaker2024-10-03T18%3A23%3A38%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/commissievergaderingen/details?