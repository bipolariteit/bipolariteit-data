[{"id":8519,"stance":"contra","typology":"factual","quote_text":"Wij hebben begrepen dat de SDE++-regeling niet goed aansluit op de praktijk, bijvoorbeeld als het gaat om concepten waarbij waterstof zowel als brandstof als als grondstof wordt geleverd. Wil de minister samen met betrokken bedrijven bekijken hoe die SDE++ beter toegesneden kan worden op de praktijk, vraag ik haar.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":304.0400000000009,"end_seconds":322.11999999999534,"actor":{"name":"André Flach","party":"SGP","role_title":null},"document":{"id":29973,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8f8f9a1b-d010-4e23-9d6c-e82d4abbcea1/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-06-03/natuur-en-milieu/plenaire-zaal/tweeminutendebat-waterstof-groen-gas-en-andere-energiedragers-cd-4-3-20-00/video","published_at":"2026-06-03T21:25:18","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-06-03/natuur-en-milieu/plenaire-zaal/tweeminutendebat-waterstof-groen-gas-en-andere-energiedragers-cd-4-3-20-00?event=speaker2026-06-03T21%3A25%3A18%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A03355","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-06-03/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-06-03T21%3A20%3A28%2B0200&end=2026-06-03T21%3A56%3A25%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"de SDE++-regeling niet goed aansluit op de praktijk, bijvoorbeeld als het gaat om concepten waarbij waterstof zowel als brandstof als als grondstof wordt geleverd","attributed_source_text":null}],"tags":[],"oppositions":[]},{"id":8520,"stance":"contra","typology":"economic","quote_text":"Tijdens het debat heb ik ook mijn grote zorgen uitgesproken over de stapeling van lastenverzwaringen via de bijmengverplichtingen in ETS2 voor de glastuinbouw. De toegezegde compensatie is tot nu toe beperkt, tijdelijk, en omgeven met staatssteunrisico's. De minister heeft intussen het wetsvoorstel bijmengverplichting naar de Kamer gestuurd, maar waar blijft de beloofde informatie over onder meer het financiële plaatje voor de sector?","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":323.1389999999956,"end_seconds":344.8600000000006,"actor":{"name":"André Flach","party":"SGP","role_title":null},"document":{"id":29973,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8f8f9a1b-d010-4e23-9d6c-e82d4abbcea1/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-06-03/natuur-en-milieu/plenaire-zaal/tweeminutendebat-waterstof-groen-gas-en-andere-energiedragers-cd-4-3-20-00/video","published_at":"2026-06-03T21:25:18","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-06-03/natuur-en-milieu/plenaire-zaal/tweeminutendebat-waterstof-groen-gas-en-andere-energiedragers-cd-4-3-20-00?event=speaker2026-06-03T21%3A25%3A18%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A03355","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-06-03/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-06-03T21%3A20%3A28%2B0200&end=2026-06-03T21%3A56%3A25%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"stapeling van lastenverzwaringen via de bijmengverplichtingen in ETS2 voor de glastuinbouw","attributed_source_text":null},{"claim_text":"De toegezegde compensatie is tot nu toe beperkt, tijdelijk, en omgeven met staatssteunrisico's","attributed_source_text":null}],"tags":[],"oppositions":[]},{"id":8521,"stance":"contra","typology":"economic","quote_text":"Ondertussen moeten heel veel Nederlandse bedrijven hun industriële activiteiten afschalen, verplaatsen ze die naar andere landen en gaan ze vervolgens daar alsnog uitstoten. Wij worden er armer van en het klimaat heeft er niets aan.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":1703.2410000000018,"end_seconds":1714.0400000000009,"actor":{"name":"Diederik Boomsma","party":"JA21","role_title":null},"document":{"id":29990,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8f8f9a1b-d010-4e23-9d6c-e82d4abbcea1/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-06-03/natuur-en-milieu/plenaire-zaal/tweeminutendebat-waterstof-groen-gas-en-andere-energiedragers-cd-4-3-20-00/video","published_at":"2026-06-03T21:48:41","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-06-03/natuur-en-milieu/plenaire-zaal/tweeminutendebat-waterstof-groen-gas-en-andere-energiedragers-cd-4-3-20-00?event=interrupter2026-06-03T21%3A48%3A41%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A03355","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-06-03/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-06-03T21%3A20%3A28%2B0200&end=2026-06-03T21%3A56%3A25%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"Nederlandse bedrijven schalen industriële activiteiten af en verplaatsen deze naar andere landen","attributed_source_text":null},{"claim_text":"Nederland wordt er armer van","attributed_source_text":null},{"claim_text":"Het klimaat heeft er niets aan","attributed_source_text":null}],"tags":[],"oppositions":[]},{"id":8522,"stance":"contra","typology":"factual","quote_text":"Datgene wat de heer Flach hier vraagt, is ook niet mogelijk en dat zit ook voor een deel in de techniek. Het gaat over de vraag of ijzerpoeder ook in de SDE++ kan worden opgenomen. Het PBL heeft in het eindadvies voor de SDE++ 2026 geadviseerd om ijzerpoeder niet op te nemen. Daarom is dat ook niet gebeurd.","quote_context":"De minister legt uit waarom de opname van ijzerpoeder in de SDE++ niet doorgaat, verwijzend naar technisch onmogelijkheden en het advies van het PBL.","prompt_version":"0b12780c7cac","start_seconds":1807.300000000003,"end_seconds":1832.8199999999997,"actor":{"name":"Stientje van Veldhoven-van der Meer","party":"BBB","role_title":"minister van Klimaat en Groene Groei"},"document":{"id":29993,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8f8f9a1b-d010-4e23-9d6c-e82d4abbcea1/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-06-03/natuur-en-milieu/plenaire-zaal/tweeminutendebat-waterstof-groen-gas-en-andere-energiedragers-cd-4-3-20-00/video","published_at":"2026-06-03T21:50:19","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-06-03/natuur-en-milieu/plenaire-zaal/tweeminutendebat-waterstof-groen-gas-en-andere-energiedragers-cd-4-3-20-00?event=speaker2026-06-03T21%3A50%3A19%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2026A03355","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-06-03/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-06-03T21%3A20%3A28%2B0200&end=2026-06-03T21%3A56%3A25%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"Het PBL heeft in het eindadvies voor de SDE++ 2026 geadviseerd om ijzerpoeder niet op te nemen.","attributed_source_text":"PBL"}],"tags":[],"oppositions":[]}]