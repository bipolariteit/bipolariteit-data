[{"id":4358,"stance":"pro","typology":"factual","quote_text":"Ik heb een vraag over de pbl's. Daar ben ik voorstander van en mevrouw Piri zelf volgens mij ook. In oktober heb ik een motie ingediend die vraagt om de pbl-capaciteit zo snel mogelijk fors uit te breiden.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":646,"end_seconds":661.0990000000002,"actor":{"name":"Ruben Brekelmans","party":"VVD","role_title":null},"document":{"id":11801,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/35e70e38-34de-4c21-8900-b3bf0121efa1/resource","video_url":"https://debatdirect.tweedekamer.nl/2024-02-12/financien/troelstrazaal/voorzetting-begrotingsonderdeel-asiel-en-migratie-16-15/video","published_at":"2024-02-12T16:27:02","speaker_video_url":"https://debatdirect.tweedekamer.nl/2024-02-12/financien/troelstrazaal/voorzetting-begrotingsonderdeel-asiel-en-migratie-16-15?event=interrupter2024-02-12T16%3A27%3A02%2B0100","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/commissievergaderingen/details?id=2024A00778","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2024-02-12/troelstrazaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2024-02-12T16%3A16%3A16%2B0100&end=2024-02-12T17%3A23%3A52%2B0100"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Rutte IV"},"claims":[],"tags":[],"oppositions":[]},{"id":4359,"stance":"pro","typology":"moral","quote_text":"We hebben nooit gezegd dat de basis voor pbl kans op asiel of nationaliteit is. Sterker nog, dat lijkt me totaal geen rechtvaardige grond voor procesbeschikbaarheidslocaties, waar mensen eigenlijk verplicht zijn om binnen te blijven.","quote_context":"Kritiek op het voorstel om procesbeschikbaarheidslocaties (PBL) te koppelen aan de kans op asiel of nationaliteit.","prompt_version":"0b12780c7cac","start_seconds":715.2400000000002,"end_seconds":734.0810000000001,"actor":{"name":"Kati Piri","party":"GroenLinks-PvdA","role_title":null},"document":{"id":11802,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/35e70e38-34de-4c21-8900-b3bf0121efa1/resource","video_url":"https://debatdirect.tweedekamer.nl/2024-02-12/financien/troelstrazaal/voorzetting-begrotingsonderdeel-asiel-en-migratie-16-15/video","published_at":"2024-02-12T16:27:53","speaker_video_url":"https://debatdirect.tweedekamer.nl/2024-02-12/financien/troelstrazaal/voorzetting-begrotingsonderdeel-asiel-en-migratie-16-15?event=speaker2024-02-12T16%3A27%3A53%2B0100","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/commissievergaderingen/details?id=2024A00778","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2024-02-12/troelstrazaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2024-02-12T16%3A16%3A16%2B0100&end=2024-02-12T17%3A23%3A52%2B0100"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Rutte IV"},"claims":[],"tags":[],"oppositions":[]},{"id":4360,"stance":"pro","typology":"factual","quote_text":"Daar zijn een heleboel asielzoekers die graag willen werken. De gemeente Arnhem zegt eigenlijk ook: wij willen heel graag dat die mensen gaan werken, want dat is goed voor het onderlinge contact, dat is goed voor … Arnhem doet een enorme berg aan de opvang.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":3270.2210000000005,"end_seconds":3283.46,"actor":{"name":"Anne-Marijke Podt","party":"D66","role_title":null},"document":{"id":11877,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/35e70e38-34de-4c21-8900-b3bf0121efa1/resource","video_url":"https://debatdirect.tweedekamer.nl/2024-02-12/financien/troelstrazaal/voorzetting-begrotingsonderdeel-asiel-en-migratie-16-15/video","published_at":"2024-02-12T17:10:40","speaker_video_url":"https://debatdirect.tweedekamer.nl/2024-02-12/financien/troelstrazaal/voorzetting-begrotingsonderdeel-asiel-en-migratie-16-15?event=interrupter2024-02-12T17%3A10%3A40%2B0100","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/commissievergaderingen/details?id=2024A00778","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2024-02-12/troelstrazaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2024-02-12T16%3A16%3A16%2B0100&end=2024-02-12T17%3A23%3A52%2B0100"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Rutte IV"},"claims":[],"tags":[],"oppositions":[]},{"id":4361,"stance":"contra","typology":"factual","quote_text":"asielzoekers mogen overigens niet werken. Dat mogen alleen asielzoekers die een bepaalde periode in Nederland zijn; dan mag het wel. Er zit dus een nuancering in, zeg ik voor de mensen die luisteren. Mevrouw Podt weet dat allemaal, maar niet iedereen heeft het kennisniveau van mevrouw Podt, zeker niet alle mensen die kijken via het internet. Er is dus een bepaalde groep die mag werken.","quote_context":"Verduidelijking van de regels rondom werken voor asielzoekers om misverstanden in de publieke opinie te voorkomen.","prompt_version":"0b12780c7cac","start_seconds":3303.661,"end_seconds":3328.8399999999992,"actor":{"name":"Eric van der Burg","party":"VVD","role_title":"staatssecretaris van Justitie en Veiligheid"},"document":{"id":11878,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/35e70e38-34de-4c21-8900-b3bf0121efa1/resource","video_url":"https://debatdirect.tweedekamer.nl/2024-02-12/financien/troelstrazaal/voorzetting-begrotingsonderdeel-asiel-en-migratie-16-15/video","published_at":"2024-02-12T17:11:16","speaker_video_url":"https://debatdirect.tweedekamer.nl/2024-02-12/financien/troelstrazaal/voorzetting-begrotingsonderdeel-asiel-en-migratie-16-15?event=speaker2024-02-12T17%3A11%3A16%2B0100","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/commissievergaderingen/details?id=2024A00778","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2024-02-12/troelst