[{"id":17273,"key":"b3b95913ab44","stance":"pro","typology":"economic","quote_text":"Laten we ook niet vergeten dat we op dit moment elk jaar 20 à 30 miljard per jaar uitgeven aan fossiele brandstoffen uit het buitenland. Dat is geld dat uit onze economie verdwijnt naar het Midden-Oosten en naar andere landen. We kunnen dat geld ook zelf bewaren. Als je de hele optelsom op die manier maakt, is het echt een stuk goedkoper om hier te investeren in verduurzaming.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":1625,"end_seconds":1643.4210000000003,"actor":{"name":"Henk-Jan Oosterhuis","party":"D66","role_title":null},"document":{"id":82595,"external_id":"0f2a644e-85ca-48ec-b989-13bd3b94c831","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/8f8f9a1b-d010-4e23-9d6c-e82d4abbcea1/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-06-03/financien/plenaire-zaal/verantwoordingsdebat-voor-het-jaar-2025-10-15/video","published_at":"2026-06-03T10:42:07","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-06-03/financien/plenaire-zaal/verantwoordingsdebat-voor-het-jaar-2025-10-15?event=speaker2026-06-03T10%3A42%3A07%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-06-03/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-06-03T10%3A15%3A11%2B0200&end=2026-06-03T13%3A00%3A03%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[{"claim_text":"we op dit moment elk jaar 20 à 30 miljard per jaar uitgeven aan fossiele brandstoffen uit het buitenland","attributed_source_text":null}],"tags":[]},{"id":17272,"key":"f15c0a218201","stance":"contra","typology":"factual","quote_text":"Er worden nog steeds, tot de dag vandaag, elke week 1.000 asielzoekers in dit land binnengelaten. Dat moet stoppen. Die grenzen moeten dicht.","quote_context":"Verwijst naar de aanhoudende instroom als reden voor het beëindigen van de coaliti