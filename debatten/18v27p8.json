[{"id":17900,"key":"94d6ba73bbbd","stance":"pro","typology":"factual","quote_text":"Ons standpunt toen was — en dat is het nog altijd — dat als de NAVO-bondgenoten de steun van Nederland inroepen, wij in principe aan dat verzoek tegemoetkomen. Deze missie laat zien dat internationale samenwerking zelden zwart-wit is. Net als bij de steun aan Oekraïne gaat het niet om of de NAVO of de EU. Beide organisaties hebben elk hun eigen rol en toegevoegde waarde.","quote_context":"SGP steunt de inzet van de Evertsen en koppelt dit aan de steun aan Oekraïne via NAVO-samenwerking.","prompt_version":"0b12780c7cac","start_seconds":1021.6390000000029,"end_seconds":1042.4400000000023,"actor":{"name":"Chris Stoffer","party":"SGP","role_title":null},"document":{"id":88884,"external_id":"7d964470-1612-421a-a16b-229f45a0047f","url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/a497d3d0-9e9f-4331-986d-9679c167c8b8/resource","video_url":"https://debatdirect.tweedekamer.nl/2026-04-16/internationaal/plenaire-zaal/aanvullende-artikel-100-brief-over-de-verlenging-van-de-nederlandse-inzet-in-de-middellandse-zee-plenaire-afronding-in-1-termijn-19-30/video","published_at":"2026-04-16T22:06:27","speaker_video_url":"https://debatdirect.tweedekamer.nl/2026-04-16/internationaal/plenaire-zaal/aanvullende-artikel-100-brief-over-de-verlenging-van-de-nederlandse-inzet-in-de-middellandse-zee-plenaire-afronding-in-1-termijn-19-30?event=speaker2026-04-16T22%3A06%3A27%2B0200","tweedekamer_activiteit_url":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2026-04-16/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2026-04-16T21%3A49%3A42%2B0200&end=2026-04-16T22%3A25%3A23%2B0200"},"periode":{"kamer":"Tweede Kamer 2025-heden","regering":"Kabinet-Jetten"},"claims":[],"tags":[]},{"id":17901,"key":"9f2550ea487b","stance":"pro","typology":"factual","quote_text":"Ik onderstreep dit graag, omdat we bij toekomstige crises vaker aangewezen zullen zijn op dit soort flexibele 