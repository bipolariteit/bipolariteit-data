[{"id":4812,"stance":"contra","typology":"legal","quote_text":"Het zou zomaar kunnen dat het juridisch gezien slimmer is om het in een andere volgorde te doen. Bij de beoordeling van bestaande asielaanvragen en nieuwe asielaanvragen kan er nieuwe jurisprudentie komen, die meegenomen kan worden bij een herbeoordeling. Op het moment dat we met die herbeoordelingen gaan beginnen en vervolgens bakzeil halen, kunnen we daar helemaal niks meer mee.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":252,"end_seconds":277.79899999999907,"actor":{"name":"Queeny Rajkowski","party":"VVD","role_title":null},"document":{"id":13548,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/6e5c5561-139d-4188-8c1f-9b2fa24b0647/resource","video_url":"https://debatdirect.tweedekamer.nl/2025-06-11/migratie-en-integratie/plenaire-zaal/onder-voorbehoud-jbz-raad-vreemdelingen-en-asielbeleid-cd-dd-11-juni-2025-18-00/video","published_at":"2025-06-11T18:44:40","speaker_video_url":"https://debatdirect.tweedekamer.nl/2025-06-11/migratie-en-integratie/plenaire-zaal/onder-voorbehoud-jbz-raad-vreemdelingen-en-asielbeleid-cd-dd-11-juni-2025-18-00?event=interrupter2025-06-11T18%3A44%3A40%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2025A04834","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2025-06-11/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2025-06-11T18%3A40%3A28%2B0200&end=2025-06-11T19%3A47%3A27%2B0200"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Schoof"},"claims":[],"tags":[],"oppositions":[]},{"id":4813,"stance":"pro","typology":"moral","quote_text":"Ik vind het een heel gekke figuur om voor de ene groep Syriërs te bepalen dat het veilig is en voor de andere groep Syriërs te bepalen dat het niet veilig is. Het gaat om mensen met dezelfde achtergrond; alleen bestaat de ene groep uit statushouders en de andere groep uit asielzoekers. Voor die groepen zouden dan verschillende regels gelden. Veilig is veilig. Wat dat betreft denk ik dat je naar eenzelfde beleid moet gaan.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":325.26900000000023,"end_seconds":347.5790000000052,"actor":{"name":"Claudia van Zanten","party":"BBB","role_title":null},"document":{"id":13553,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/6e5c5561-139d-4188-8c1f-9b2fa24b0647/resource","video_url":"https://debatdirect.tweedekamer.nl/2025-06-11/migratie-en-integratie/plenaire-zaal/onder-voorbehoud-jbz-raad-vreemdelingen-en-asielbeleid-cd-dd-11-juni-2025-18-00/video","published_at":"2025-06-11T18:45:52","speaker_video_url":"https://debatdirect.tweedekamer.nl/2025-06-11/migratie-en-integratie/plenaire-zaal/onder-voorbehoud-jbz-raad-vreemdelingen-en-asielbeleid-cd-dd-11-juni-2025-18-00?event=speaker2025-06-11T18%3A45%3A52%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2025A04834","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2025-06-11/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2025-06-11T18%3A40%3A28%2B0200&end=2025-06-11T19%3A47%3A27%2B0200"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Schoof"},"claims":[],"tags":[],"oppositions":[]},{"id":4814,"stance":"contra","typology":"factual","quote_text":"Voor wat betreft Syrië zouden wij graag willen dat Syriërs direct worden teruggestuurd, ook de meer dan 70.000 Syriërs in Nederland met een tijdelijke verblijfsvergunning. Het is veilig, dus trek die vergunning in en stuur ze terug.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":370.5,"end_seconds":383.08000000000175,"actor":{"name":"Marina Vondeling","party":"PVV","role_title":null},"document":{"id":13555,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/6e5c5561-139d-4188-8c1f-9b2fa24b0647/resource","video_url":"https://debatdirect.tweedekamer.nl/2025-06-11/migratie-en-integratie/plenaire-zaal/onder-voorbehoud-jbz-raad-vreemdelingen-en-asielbeleid-cd-dd-11-juni-2025-18-00/video","published_at":"2025-06-11T18:46:37","speaker_video_url":"https://debatdirect.tweedekamer.nl/2025-06-11/migratie-en-integratie/plenaire-zaal/onder-voorbehoud-jbz-raad-vreemdelingen-en-asielbeleid-cd-dd-11-juni-2025-18-00?event=speaker2025-06-11T18%3A46%3A37%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2025A04834","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2025-06-11/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2025-06-11T18%3A40%3A28%2B0200&end=2025-06-11T19%3A47%3A27%2B0200"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Schoof"},"claims":[{"claim_text":"meer dan 70.000 Syriërs in Nederland met een tijdelijke verblijfsvergunning","attributed_source_text":null},{"claim_text":"Syrië is veilig","attributed_source_text":null}],"tags":[],"oppositions":[]},{"id":4815,"stance":"contra","typology":"moral","quote_text":"Om echt grip te krijgen op de migratie en te komen tot een humaner en beter beleid, moeten we toe naar een fundamenteel ander asielbeleid, waarbij we mensen opvangen en hulp bieden buiten Europa en we die perverse prikkel van het huidige beleid, waarbij mensen eerst die gevaarlijk weg moeten afleggen, gaan doorbreken.","quote_context":null,"prompt_version":"0b12780c7cac","start_seconds":481.6800000000003,"end_seconds":499.01900000000023,"actor":{"name":"Diederik Boomsma","party":"NSC","role_title":null},"document":{"id":13558,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/6e5c5561-139d-4188-8c1f-9b2fa24b0647/resource","video_url":"https://debatdirect.tweedekamer.nl/2025-06-11/migratie-en-integratie/plenaire-zaal/onder-voorbehoud-jbz-raad-vreemdelingen-en-asielbeleid-cd-dd-11-juni-2025-18-00/video","published_at":"2025-06-11T18:48:13","speaker_video_url":"https://debatdirect.tweedekamer.nl/2025-06-11/migratie-en-integratie/plenaire-zaal/onder-voorbehoud-jbz-raad-vreemdelingen-en-asielbeleid-cd-dd-11-juni-2025-18-00?event=speaker2025-06-11T18%3A48%3A13%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2025A04834","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2025-06-11/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2025-06-11T18%3A40%3A28%2B0200&end=2025-06-11T19%3A47%3A27%2B0200"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Schoof"},"claims":[],"tags":[],"oppositions":[]},{"id":4816,"stance":"pro","typology":"factual","quote_text":"Uit diezelfde brief van de minister blijkt dat de situatie instabiel is en dat er nog sprake is van veel gewapende groepen en veel gewapend conflict. Zo'n beetje alle mensenrechtenorganisaties geven aan: pas dat beleid niet aan, want dat is onverantwoord.","quote_context":"Kritiek op de aanpassing van het asielbeleid ten aanzien van Syrië door de minister.","prompt_version":"0b12780c7cac","start_seconds":628.760000000002,"end_seconds":644.260000000002,"actor":{"name":"Stephan van Baarle","party":"DENK","role_title":null},"document":{"id":13562,"url":"https://gegevensmagazijn.tweedekamer.nl/OData/v4/2.0/Verslag/6e5c5561-139d-4188-8c1f-9b2fa24b0647/resource","video_url":"https://debatdirect.tweedekamer.nl/2025-06-11/migratie-en-integratie/plenaire-zaal/onder-voorbehoud-jbz-raad-vreemdelingen-en-asielbeleid-cd-dd-11-juni-2025-18-00/video","published_at":"2025-06-11T18:50:45","speaker_video_url":"https://debatdirect.tweedekamer.nl/2025-06-11/migratie-en-integratie/plenaire-zaal/onder-voorbehoud-jbz-raad-vreemdelingen-en-asielbeleid-cd-dd-11-juni-2025-18-00?event=speaker2025-06-11T18%3A50%3A45%2B0200","tweedekamer_activiteit_url":"https://www.tweedekamer.nl/debat_en_vergadering/plenaire_vergaderingen/details/activiteit?id=2025A04834","redactie_review":null,"raw_video_url":"https://livestreaming.b67v2.tweedekamer.nl/2025-06-11/plenairezaal/index.m3u8?hd=1&subtitles=vod&keyframes=1&start=2025-06-11T18%3A40%3A28%2B0200&end=2025-06-11T19%3A47%3A27%2B0200"},"periode":{"kamer":"Tweede Kamer 2023-2025","regering":"Kabinet-Schoof"},"claims":[{"claim_text":"de situatie in Syrië is instabiel en er is sprake van veel gewapende groepen en veel gewapend conflict","attributed_source_text":"brief van de minister"},{"claim_text":"pas dat beleid niet aan, want dat is onverantwoord","attributed_source_text":"mensenrechtenorganisaties"}],"tags":[],"oppositions":[]}]